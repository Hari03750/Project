@page
@model EventEaseApp.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>An unexpected error occurred. Please try again, and contact support if the problem continues.</p>
@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> @Model.RequestId</p>
}
